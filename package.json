{
  "name": "insightly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "test:e2e": "playwright test",
    "test:rules": "node scripts/check-java.mjs && firebase emulators:exec --only auth,database,firestore,storage \"npm run test:rules:runner\"",
    "test:rules:runner": "tsx --test tests/rules.test.ts",
    "seed": "tsx scripts/seed.ts",
    "publish:scheduled": "tsx scripts/publish-scheduled.ts",
    "emulators": "node scripts/check-java.mjs && firebase emulators:start",
    "deploy:auth": "firebase deploy --only auth",
    "deploy:rules": "firebase deploy --only database,firestore:rules,storage",
    "deploy:indexes": "firebase deploy --only firestore:indexes"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.3.0",
    "isomorphic-dompurify": "^3.19.0",
    "jquery": "^4.0.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "summernote": "^0.9.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/jquery": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.30.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}

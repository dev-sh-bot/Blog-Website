rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true; }
    function isManager() { return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'admin']; }
    function published(data) { return data.status == 'published' && data.publishedAt <= request.time; }

    match /posts/{postId} {
      allow read: if published(resource.data);
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} { allow read: if true; allow write: if isManager(); }
    match /tags/{id} { allow read: if true; allow write: if isManager(); }
    match /authors/{id} { allow read: if true; allow write: if isManager(); }
    match /media/{id} { allow read, write: if isAdmin(); }
    match /subscribers/{id} { allow read, update, delete: if isAdmin(); allow create: if false; }
    match /settings/{id} { allow read: if id == 'public'; allow write: if isManager(); }
    match /redirects/{id} { allow read: if false; allow write: if isAdmin(); }
    // Administrator role transitions are validated by the server API. Do not expose
    // direct browser writes that could bypass last-owner and role-escalation checks.
    match /admins/{id} { allow read: if isManager(); allow write: if false; }
  }
}
